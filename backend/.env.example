# 图像生成（Module 05 场景图）。已验证：sublyx 的"PDD生图"key 分组只有 gpt-image-1/1.5/2/2-firefly 权限。
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.sublyx.org/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# 文本模型（Module 02分析/03关键词/04文案，需要单独一个有 chat/completions 权限的key，不能复用生图key）
OPENAI_TEXT_API_KEY=
OPENAI_TEXT_BASE_URL=
OPENAI_TEXT_MODEL=

PDD_AGENT_OUTPUT_DIR=output
